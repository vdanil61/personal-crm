# Server .env for deploy/compose.yaml, chmod 600.
# Prod: /home/deploy/personal-crm/.env; staging: /home/deploy/personal-crm-staging/.env.
# Each environment needs its own database password, signing secret and SMTP key.
# Fill in the values; never commit the real file.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Email of the owner: all data that existed before login belongs to this user
OWNER_EMAIL=
# Signs logins; make it with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Address the app is opened at, used in login links
# Prod: https://app.percrm.ru; staging: https://test-app.percrm.ru
BETTER_AUTH_URL=
# Where emails are sent (Mailpit on this machine, Resend on the server)
SMTP_URL=
# Sender of login emails, for example: "Личная CRM <noreply@example.com>"
MAIL_FROM=
