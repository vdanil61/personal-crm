# Copy to .env and fill in the values. Never commit .env.

# Used by compose.yaml to create the local Postgres container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Used by the app; format: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=

# Email of the owner: all data that existed before login belongs to this user
OWNER_EMAIL=
# Signs logins; make it with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Address the app is opened at, used in login links
BETTER_AUTH_URL=
# Where emails are sent (Mailpit on this machine, Resend on the server)
SMTP_URL=
# Sender of login emails, for example: "Личная CRM <noreply@example.com>"
MAIL_FROM=
# Page of the local mail catcher, used by tests
MAILPIT_URL=
